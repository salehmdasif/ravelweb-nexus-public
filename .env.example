# Ravelweb Nexus — Environment Variable Template
# Copy this file to .env and fill in your own values.
# NEVER commit a .env file with real credentials to version control.

# ── Application ────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_VALUE_HERE

# ── Databases ──────────────────────────────────────────────────────────────────
# Main (control) database: stores organizations, users, licenses, tenant routing
MAIN_DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_MAIN_DB_NAME
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_MAIN_DB_NAME

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
RATELIMIT_STORAGE_URI=redis://localhost:6379

# ── License JWT ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LICENSE_JWT_SECRET=YOUR_VALUE_HERE

# ── Mobile API JWT ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=YOUR_VALUE_HERE
JWT_ACCESS_TOKEN_EXPIRES=1800
JWT_REFRESH_TOKEN_EXPIRES=604800

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_VALUE_HERE
GOOGLE_CLIENT_SECRET=YOUR_VALUE_HERE

# ── SMTP (Email) ───────────────────────────────────────────────────────────────
# Gmail example: use an App Password, not your account password.
# Alternatives: Brevo, Mailgun, or any SMTP relay.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=YOUR_VALUE_HERE
MAIL_PASSWORD=YOUR_VALUE_HERE
MAIL_DEFAULT_SENDER=YOUR_VALUE_HERE
